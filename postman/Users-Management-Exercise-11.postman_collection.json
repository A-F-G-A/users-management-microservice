{
  "info": {
    "name": "Users Management - Exercise 11",
    "description": "CRUDL for users and cellphones. Public registration always creates MEMBER/PENDING users with a server-generated id. Run Login with the bootstrap ADMIN to store the JWT before protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Activity 11 User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().id);",
                  "pm.test('Password is not returned', () => pm.expect(pm.response.text()).not.to.include('password'));",
                  "pm.test('Self-registration is MEMBER', () => pm.expect(pm.response.json().role).to.eql('MEMBER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Escalation attempt role=ADMIN (expect MEMBER)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"00000000-0000-0000-0000-00000000dead\",\n  \"name\": \"Escalation Attempt\",\n  \"email\": \"escalation-{{$timestamp}}@example.test\",\n  \"password\": \"{{userPassword}}\",\n  \"role\": \"ADMIN\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "pm.test('role=ADMIN is ignored', () => pm.expect(pm.response.json().role).to.eql('MEMBER'));",
                  "pm.test('client id is ignored', () => pm.expect(pm.response.json().id).to.not.eql('00000000-0000-0000-0000-00000000dead'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Users listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User found', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Activity 11 User Updated\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"MEMBER\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cellphones",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Acme\",\n  \"imei\": \"{{imei}}\",\n  \"pulgadas\": 6.2,\n  \"megapixeles\": 48,\n  \"ram\": 8,\n  \"almacenamientoPrincipal\": 128,\n  \"almacenamientoSecundario\": null,\n  \"sistemaOperativo\": \"Android\",\n  \"operador\": \"Carrier\",\n  \"tecnologiaBanda\": \"5G\",\n  \"wifi\": true,\n  \"bluetooth\": true,\n  \"camaras\": 3,\n  \"marcaCpu\": \"Acme CPU\",\n  \"velocidadCpu\": 2.4,\n  \"nfc\": true,\n  \"huella\": true,\n  \"ir\": false,\n  \"resisteAgua\": true,\n  \"cantidadSim\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cellphone created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('cellphoneId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cellphones listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cellphones/{{cellphoneId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cellphone found', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Acme Updated\",\n  \"imei\": \"{{imei}}\",\n  \"pulgadas\": 6.2,\n  \"megapixeles\": 48,\n  \"ram\": 8,\n  \"almacenamientoPrincipal\": 128,\n  \"almacenamientoSecundario\": null,\n  \"sistemaOperativo\": \"Android\",\n  \"operador\": \"Carrier\",\n  \"tecnologiaBanda\": \"5G\",\n  \"wifi\": false,\n  \"bluetooth\": true,\n  \"camaras\": 3,\n  \"marcaCpu\": \"Acme CPU\",\n  \"velocidadCpu\": 2.4,\n  \"nfc\": true,\n  \"huella\": true,\n  \"ir\": false,\n  \"resisteAgua\": true,\n  \"cantidadSim\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/cellphones/{{cellphoneId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cellphone updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate IMEI (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Duplicate\", \"imei\": \"{{imei}}\", \"pulgadas\": 6.2,\n  \"megapixeles\": 48, \"ram\": 8, \"almacenamientoPrincipal\": 128,\n  \"sistemaOperativo\": \"Android\", \"operador\": \"Carrier\", \"tecnologiaBanda\": \"5G\",\n  \"wifi\": true, \"bluetooth\": true, \"camaras\": 2, \"marcaCpu\": \"CPU\",\n  \"velocidadCpu\": 2.0, \"nfc\": false, \"huella\": false, \"ir\": false,\n  \"resisteAgua\": false, \"cantidadSim\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate IMEI rejected', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid IMEI (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Invalid\", \"imei\": \"123\", \"pulgadas\": 6.2,\n  \"megapixeles\": 48, \"ram\": 8, \"almacenamientoPrincipal\": 128,\n  \"sistemaOperativo\": \"Android\", \"operador\": \"Carrier\", \"tecnologiaBanda\": \"5G\",\n  \"wifi\": true, \"bluetooth\": true, \"camaras\": 2, \"marcaCpu\": \"CPU\",\n  \"velocidadCpu\": 2.0, \"nfc\": false, \"huella\": false, \"ir\": false,\n  \"resisteAgua\": false, \"cantidadSim\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid IMEI rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid IMEI check digit - Luhn (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Invalid Luhn\", \"imei\": \"012345678901234\", \"pulgadas\": 6.2,\n  \"megapixeles\": 48, \"ram\": 8, \"almacenamientoPrincipal\": 128,\n  \"sistemaOperativo\": \"Android\", \"operador\": \"Carrier\", \"tecnologiaBanda\": \"5G\",\n  \"wifi\": true, \"bluetooth\": true, \"camaras\": 2, \"marcaCpu\": \"CPU\",\n  \"velocidadCpu\": 2.0, \"nfc\": false, \"huella\": false, \"ir\": false,\n  \"resisteAgua\": false, \"cantidadSim\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Luhn check digit rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing ID (expect 404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/cellphones/{{missingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing cellphone returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated list (expect 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/cellphones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated request rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/cellphones/{{cellphoneId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cellphone deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
