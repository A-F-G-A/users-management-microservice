# Copie este archivo como .env y reemplace los valores por secretos locales.
DB_USERNAME=users_app
DB_PASSWORD=replace-with-a-unique-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
JWT_SECRET=
JWT_EXPIRATION_SECONDS=900
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Solo para el primer arranque de una base nueva (sin ADMIN). Borre la contraseña tras crear el ADMIN.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
